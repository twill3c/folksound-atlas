{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folksound-atlas/schemas/models.schema.json",
  "title": "models.json — Embedding を作ったモデルの台帳",
  "type": "object",
  "required": ["models"],
  "additionalProperties": false,
  "properties": {
    "generated_at": { "type": "string" },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id", "name", "type", "embedding_dimension",
        "training_objective", "saw_country_labels",
        "may_support_geographic_claim", "version"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["features", "cnn-autoencoder", "cnn-classifier", "pretrained"] },
        "embedding_dimension": { "type": "integer", "exclusiveMinimum": 0 },
        "training_objective": { "type": "string", "minLength": 1 },
        "training_dataset": { "type": ["string", "null"] },
        "saw_country_labels": {
          "type": "boolean",
          "description": "SPEC §2.2。true のモデルは地理の主張に使えない"
        },
        "may_support_geographic_claim": {
          "type": "boolean",
          "description": "saw_country_labels の否定でなければならない(T-011 が検査する)"
        },
        "label_note": {
          "type": "string",
          "description": "画面に出す断り書き。手書きせずここから描画する(F-14)"
        },
        "inference_time_ms": { "type": ["number", "null"] },
        "model_size_bytes": { "type": ["integer", "null"] },
        "version": { "type": "string" }
      }
    }
  }
}
