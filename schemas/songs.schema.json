{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folksound-atlas/schemas/songs.schema.json",
  "title": "songs.json — 録音の目録と出自",
  "type": "object",
  "required": ["dataset_version", "generated_at", "songs"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "songs": {
      "type": "array",
      "items": { "$ref": "#/$defs/song" }
    }
  },
  "$defs": {
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "country", "source", "source_url",
        "license", "license_url", "rights_verified",
        "underlying_work_status", "retrieval_date", "sha256",
        "duration_s", "sample_rate_original"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^folk_[0-9]{6}$" },
        "title": { "type": "string", "minLength": 1 },
        "country": {
          "type": "string",
          "minLength": 1,
          "description": "Commons のカテゴリ由来。推定で埋めてはならない(SPEC §5.1)"
        },
        "country_source_category": {
          "type": "string",
          "description": "この国名の根拠となった Commons カテゴリ名。省略不可の実質を持つ"
        },
        "region": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "coordinate_precision": {
          "type": "string",
          "enum": ["exact", "country_centroid", "unknown"],
          "description": "国の代表点しか無いものを exact と呼ばない(仕様書 §59)"
        },
        "source": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "rights_verified": { "const": true },
        "underlying_work_status": {
          "type": "string",
          "enum": ["public_domain", "traditional", "freely_licensed"],
          "description": "録音とは別に確かめた原曲の権利状態(SPEC §5.2)"
        },
        "retrieval_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "sample_rate_original": { "type": "integer", "exclusiveMinimum": 0 },
        "segment_count": { "type": "integer", "minimum": 1 },
        "split": { "type": "string", "enum": ["train", "val", "test"] },
        "uploader": {
          "type": ["string", "null"],
          "description": "H-02 の交絡検査に使う。表示には使わない"
        },
        "has_demo_audio": { "type": "boolean" }
      }
    }
  }
}
